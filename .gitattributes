* text=auto

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sql text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf

# Minified Vite chunks may intentionally contain whitespace in template
# literals; treat the committed build artifact as opaque for diffs.
internal/frontend/dist/assets/* -text -diff

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# MultiSpeed has no authentication. Keep this on a trusted LAN or protect it
# with an authenticating reverse proxy and host firewall rules.
APP_LISTEN_ADDR=0.0.0.0:8787
# Comma-separated exact DNS names or IPs accepted in the HTTP Host header.
# A wildcard listener already accepts unicast IP literals without an allowlist,
# but arbitrary DNS names are rejected against DNS rebinding unless listed here.
APP_TRUSTED_HOSTS=
# Comma-separated exact LibreSpeed custom backend base URLs authorized by the
# deployment. Empty disables all custom URLs. Plain HTTP also needs the task's
# explicit allowInsecure option.
APP_ALLOWED_CUSTOM_SERVER_URLS=
# Disabled by default. When true, a client that can reach the listener may
# upload one separately obtained Linux amd64 Ookla executable into the writable
# /data mount. Never expose this unauthenticated endpoint to an untrusted network.
APP_ALLOW_OOKLA_BINARY_UPLOAD=false
# compose.yaml deliberately fixes APP_DATA_DIR=/data so the database and
# managed provider files always use the persistent ./data mount.
APP_LOG_LEVEL=INFO
APP_SHUTDOWN_TIMEOUT=20s
TZ=Europe/Berlin

# Compose runs as this non-root host identity so ./data remains writable.
# Set these to the output of: id -u ; id -g
MULTISPEED_UID=1000
MULTISPEED_GID=1000
MULTISPEED_IMAGE=ghcr.io/dude2k/multispeed:latest

# LibreSpeed CLI v1.0.13 is built into the image from official LGPL source.
LIBRESPEED_BINARY=/usr/local/bin/librespeed-cli

# Ookla is never bundled. For managed upload, keep this default, keep /data
# writable, and do not create a mount or directory at the final speedtest path.
# For an external read-only file instead, leave upload disabled, mount that file
# outside /data, and change OOKLA_BINARY to its container path.
OOKLA_BINARY=/data/providers/ookla/speedtest
# Prefer the explicit Settings UI flow. This legacy-named headless override
# authorizes MultiSpeed to pass --accept-license and --accept-gdpr after the
# operator has agreed to the current EULA and Terms, reviewed the Privacy
# Policy, and confirmed that personal-computer/non-commercial use, device type,
# and any network access from multiple devices fit the current documents or
# have separate written authorization for this server, container, networked,
# automated, or commercial deployment.
# It opens only MultiSpeed's technical gate and does not grant a license.
ACCEPT_OOKLA_EULA=false
